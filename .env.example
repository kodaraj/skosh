# Which DataProvider the app uses: mock | supabase | rest
# "mock" runs entirely offline with bundled JSON and needs no other config.
EXPO_PUBLIC_DATA_PROVIDER=mock

# Required only when EXPO_PUBLIC_DATA_PROVIDER=supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Required only when EXPO_PUBLIC_DATA_PROVIDER=rest
EXPO_PUBLIC_API_BASE_URL=
